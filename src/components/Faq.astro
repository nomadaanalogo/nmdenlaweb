---
import Icon from "./Icon.astro";
import { FAQ } from "../data/faq";
---

<section
  id="preguntas"
  class="slide section-scroll-offset relative flex flex-col overflow-x-clip md:min-h-screen"
>
  <div class="relative mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-4 pt-20 pb-10 sm:px-6 md:px-10 md:pt-28 md:pb-16">
    <div class="reveal mb-6 text-center md:mb-10">
      <p class="mb-2 text-xs uppercase tracking-[0.25em] text-muted md:mb-3 md:text-sm">Preguntas frecuentes</p>
      <h2 class="font-display text-balance text-2xl font-bold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
        Páginas web y SEO en <span class="text-gradient">Colombia y EE. UU.</span>
      </h2>
    </div>

    <div class="reveal reveal-delay-1 flex flex-col gap-2.5 md:gap-3">
      {
        FAQ.map((item, i) => (
          <details class="faq-item group" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 md:p-5">
              <h3 class="font-display text-[0.9375rem] font-semibold leading-snug text-white md:text-lg">{item.q}</h3>
              <span class="faq-toggle" aria-hidden="true">
                <Icon name="plus" class="h-4 w-4" />
              </span>
            </summary>
            <p class="px-4 pb-4 text-sm leading-relaxed text-muted md:px-5 md:pb-5 md:text-base">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
