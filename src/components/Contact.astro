---
import Icon from "./Icon.astro";
import Footer from "./Footer.astro";
import { EMAIL, WHATSAPP_URL } from "../config";
---

<section
  id="contacto"
  class="slide section-scroll-offset relative flex flex-col overflow-x-clip md:min-h-screen"
>
  <div
    class="glow-blob left-1/2 top-1/2 h-96 w-160 -translate-x-1/2 -translate-y-1/2 bg-neon/15"
    data-parallax="0.1"
    aria-hidden="true"
  >
  </div>
  <div
    class="glow-blob left-1/2 top-1/2 h-72 w-lg -translate-x-1/2 -translate-y-1/2 bg-neon-2/15"
    data-parallax="-0.06"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex flex-1 flex-col items-center justify-center px-4 py-14 sm:px-6 md:px-10 md:py-16">
    <div class="reveal mx-auto max-w-4xl text-center">
      <h2 class="font-display text-balance text-2xl font-bold leading-tight tracking-tight text-white sm:text-4xl md:text-6xl">
        Tu negocio ya funciona.<br /><span class="text-gradient">Potenciémoslo.</span>
      </h2>

      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row md:mt-10 md:gap-4">
        <a
          href="#diagnostico"
          class="btn-primary w-full sm:w-auto"
        >
          Quiero mi propuesta
          <Icon name="arrowRight" />
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="neon-ring flex w-full items-center justify-center gap-2 rounded-full px-6 py-3 text-[0.9375rem] font-medium md:px-8 md:py-4 md:text-base text-white transition-colors hover:bg-white/5 sm:w-auto"
        >
          <Icon name="message" class="h-4 w-4 md:h-5 md:w-5" />
          WhatsApp
        </a>
      </div>

      <a href={`mailto:${EMAIL}`} class="mt-5 inline-flex items-center gap-2 text-sm text-muted md:mt-6 transition-colors hover:text-white">
        <Icon name="mail" class="h-4 w-4" />
        {EMAIL}
      </a>
    </div>
  </div>

  <Footer />
</section>
