---
import Icon from "./Icon.astro";
---

<section id="top" class="slide relative flex min-h-screen flex-col overflow-x-clip bg-grid">
  <div
    class="glow-blob left-1/2 -top-24 h-112 w-3xl -translate-x-1/2 bg-neon/25"
    data-parallax="0.12"
    aria-hidden="true"
  >
  </div>
  <div
    class="glow-blob -right-32 top-72 h-96 w-96 bg-neon-2/15"
    data-parallax="-0.08"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-1 flex-col items-center justify-center px-4 pt-24 pb-16 text-center sm:px-6 md:px-10 md:pt-28 md:pb-20">
    <div class="flex flex-col items-center gap-5 md:gap-7">
      <span class="hero-chip animate-fade-up">
        <span class="hero-chip-check" aria-hidden="true">
          <Icon name="check" class="h-3 w-3 md:h-3.5 md:w-3.5" />
        </span>
        <span>Tu negocio <strong class="font-semibold text-white">ya funciona</strong></span>
        <span class="hero-chip-wifi" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="url(#chip-wifi-grad)" stroke-width="2.4" stroke-linecap="round">
            <defs>
              <linearGradient id="chip-wifi-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#b954ff" />
                <stop offset="1" stop-color="#ff4ecd" />
              </linearGradient>
            </defs>
            <path d="M2.5 9a14 14 0 0 1 19 0" />
            <path d="M6 12.6a9 9 0 0 1 12 0" />
            <path d="M9.4 16.1a4 4 0 0 1 5.2 0" />
            <circle cx="12" cy="19.5" r="1.3" fill="#ff4ecd" stroke="none" />
          </svg>
        </span>
      </span>

      <h1 class="animate-fade-up font-display max-w-[18ch] text-balance text-[2.25rem] font-bold leading-[1] tracking-[-0.035em] text-white [animation-delay:90ms] sm:text-5xl md:text-7xl lg:text-[5.25rem]">
        Hagamos que tus clientes te encuentren <span class="text-gradient">más fácil</span>
      </h1>

      <p class="animate-fade-up text-base text-muted [animation-delay:180ms] md:text-2xl">
        En las IAs, en buscadores y en mapas.
      </p>

      <a
        href="#diagnostico"
        class="btn-primary animate-fade-up mt-1 [animation-delay:270ms]"
      >
        Quiero vender más
        <Icon name="arrowRight" />
      </a>
    </div>
  </div>
</section>
