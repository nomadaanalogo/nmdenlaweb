---
import Icon from "./Icon.astro";

// <b>…</b> resalta en blanco las frases clave.
const SERVICES = [
  {
    icon: "sparkles" as const,
    title: "Visible para las IAs",
    text: "Preparamos tu negocio para aparecer cuando alguien le pregunta a <b>ChatGPT o Gemini</b> por lo que vendes.",
  },
  {
    icon: "mapPin" as const,
    title: "Arriba en Google y en Maps",
    text: "Posicionamos tu web y tu perfil para que te encuentren <b>antes que a tu competencia</b> y <b>más clientes cercanos</b> te llamen.",
  },
  {
    icon: "devices" as const,
    title: "Una web rápida en cualquier pantalla",
    text: "Tu página <b>carga en segundos</b> y se ve bien en celular, tablet y computador.",
  },
];

const DELAY_CLASSES = ["reveal-delay-1", "reveal-delay-2", "reveal-delay-3"];
---

<section
  id="servicios"
  class="slide section-scroll-offset relative flex flex-col overflow-x-clip md:min-h-screen"
>
  <div
    class="glow-blob left-1/2 top-1/2 h-80 w-3xl -translate-x-1/2 -translate-y-1/2 bg-neon/10"
    data-parallax="0.06"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 pt-20 pb-12 sm:px-6 md:px-10 md:pt-28 md:pb-16">
    <div class="reveal mb-8 text-center md:mb-14">
      <p class="mb-2 text-xs uppercase tracking-[0.25em] text-muted md:mb-3 md:text-sm">Qué hacemos</p>
      <h2 class="font-display text-balance text-2xl font-bold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
        Todo para que tus clientes <span class="text-gradient">te encuentren</span>
      </h2>
    </div>

    <ul class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      {
        SERVICES.map((item, i) => (
          <li class:list={["reveal group service-card", DELAY_CLASSES[i]]}>
            <div class="service-icon">
              <Icon name={item.icon} class="icon-neon h-8 w-8 md:h-10 md:w-10" />
            </div>
            <h3 class="font-display text-lg font-semibold leading-snug text-white md:text-xl">{item.title}</h3>
            <p
              class="text-sm leading-relaxed text-muted md:text-base [&_b]:font-medium [&_b]:text-white"
              set:html={item.text}
            />
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-8 flex justify-center md:mt-12">
      <a href="#diagnostico" class="btn-primary">
        Quiero mi propuesta
        <Icon name="arrowRight" />
      </a>
    </div>
  </div>
</section>
