---
import { EMAIL } from "../config";

// Para agregar redes sociales, súmalas también a SAME_AS en src/layouts/Layout.astro.
const year = new Date().getFullYear();
---

<footer class="relative shrink-0 border-t border-line py-6">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 text-center sm:px-6 md:flex-row md:gap-6 md:px-10 md:text-left">
    <div class="flex flex-col gap-1">
      <p class="font-display text-sm text-muted">
        nmd<span class="text-neon">enlaweb</span> © {year} · Estudio de diseño web y marketing digital
      </p>
      <p class="text-xs text-muted/80">
        Páginas web, SEO y Google Maps para negocios en Colombia y negocios hispanos en Estados Unidos.
      </p>
    </div>

    <a href={`mailto:${EMAIL}`} class="text-sm text-muted transition-colors hover:text-neon">{EMAIL}</a>
  </div>
</footer>
