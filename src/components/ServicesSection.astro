---
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

interface ServiceItem {
  icon: IconName;
  title: string;
  description: string;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  titleAccent: string;
  subtitle: string;
  items: ServiceItem[];
  tinted?: boolean;
}

const { id, eyebrow, title, titleAccent, subtitle, items, tinted = false } = Astro.props;

const DELAY_CLASSES = ["reveal-delay-1", "reveal-delay-2", "reveal-delay-3", "reveal-delay-4"];
---

<section
  id={id}
  class:list={[
    "slide section-scroll-offset relative flex h-screen flex-col overflow-x-hidden",
    { "bg-surface/30": tinted },
  ]}
>
  <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-6 py-20 md:px-10">
    <div class="reveal max-w-2xl">
      <p class="mb-3 text-sm uppercase tracking-[0.25em] text-muted">{eyebrow}</p>
      <h2 class="font-display text-balance text-4xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
        {title} <span class="text-gradient">{titleAccent}</span>
      </h2>
      <p class="mt-3 text-balance text-lg leading-relaxed text-muted">{subtitle}</p>
    </div>

    <div
      class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-[repeat(var(--cols),minmax(0,1fr))] md:gap-5"
      style={`--cols: ${items.length}`}
    >
      {
        items.map((item, index) => (
          <div
            class:list={[
              "reveal group rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-neon/40",
              DELAY_CLASSES[index % DELAY_CLASSES.length],
            ]}
          >
            <Icon name={item.icon} class="icon-neon h-6 w-6" />
            <h3 class="font-display mt-5 text-lg font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
