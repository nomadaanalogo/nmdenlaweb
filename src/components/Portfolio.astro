---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import kiel from "../assets/portfolio/kiel.png";
import mapura from "../assets/portfolio/mapura.png";
import damer from "../assets/portfolio/damer.png";

// Capturas 1440×900 del hero de cada sitio, en src/assets/portfolio/.
const PROJECTS: { name: string; url: string; domain: string; sector: string; city: string; image?: ImageMetadata }[] = [
  { name: "Kiel", url: "https://kiel.com.co", domain: "kiel.com.co", sector: "Mobiliario corporativo", city: "Palmira · Cali", image: kiel },
  { name: "Mapura Grupo Consultor", url: "https://grupomapura.co", domain: "grupomapura.co", sector: "Firma de abogados", city: "Palmira · Cali", image: mapura },
  { name: "Damer Producciones", url: "https://damerproducciones.com", domain: "damerproducciones.com", sector: "Producción de eventos", city: "Cali", image: damer },
];

const DELAY_CLASSES = ["reveal-delay-1", "reveal-delay-2", "reveal-delay-3"];
---

<section id="portafolio" class="slide section-scroll-offset relative flex flex-col overflow-x-clip md:min-h-screen">
  <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 pt-20 pb-10 sm:px-6 md:px-10 md:pt-28 md:pb-16">
    <div class="reveal mb-6 text-center md:mb-12">
      <p class="mb-2 text-xs uppercase tracking-[0.25em] text-muted md:mb-3 md:text-sm">Proyectos</p>
      <h2 class="font-display text-balance text-2xl font-bold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
        Algunos sitios que <span class="text-gradient">hemos creado.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 md:gap-6">
      {
        PROJECTS.map((project, index) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["reveal group project-card", DELAY_CLASSES[index]]}
          >
            <div class="flex items-center gap-1.5 border-b border-line bg-surface-2 px-3 py-2 md:px-4 md:py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-white/15" />
              <span class="h-2.5 w-2.5 rounded-full bg-white/15" />
              <span class="h-2.5 w-2.5 rounded-full bg-white/15" />
              <span class="ml-3 truncate rounded-md bg-ink px-3 py-1 text-xs text-muted">{project.domain}</span>
            </div>

            <div class="relative flex aspect-video items-center justify-center overflow-hidden bg-grid">
              {project.image ? (
                <Image
                  src={project.image}
                  alt={`Página de inicio de ${project.name}`}
                  widths={[480, 800]}
                  sizes="(min-width: 768px) 360px, 100vw"
                  class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <>
                  <div class="glow-blob h-40 w-40 bg-neon/25 transition-transform duration-500 group-hover:scale-150" aria-hidden="true" />
                  <span class="font-display relative px-6 text-center text-3xl font-bold leading-tight text-white">
                    {project.name}
                  </span>
                </>
              )}
            </div>

            <div class="flex items-center justify-between gap-3 p-4 md:gap-4 md:p-5">
              <div class="min-w-0">
                <p class="font-display text-base font-semibold text-white md:text-lg">{project.sector}</p>
                <p class="text-sm text-muted">{project.city}</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 md:h-11 md:w-11 items-center justify-center rounded-full border border-line text-white transition-colors group-hover:border-transparent group-hover:bg-linear-to-r group-hover:from-neon group-hover:to-neon-2">
                <Icon name="arrowUpRight" class="h-4 w-4 md:h-5 md:w-5" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
